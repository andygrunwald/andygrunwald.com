---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  title: string;
}

const { src, alt, title } = Astro.props;
---

<div class="mb-10">
  <Image {src} {alt} {title} layout="constrained" class="rounded-lg" />
</div>
