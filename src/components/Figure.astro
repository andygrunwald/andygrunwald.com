---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  title: string;
  alt: string;
  link?: string;
}

const { src, title, alt, link } = Astro.props;
---

<div class="mb-10">
  <figure>
    {
      link ? (
        <a href={link}>
          <Image {src} {alt} {title} layout="constrained" class="rounded-lg" />
        </a>
      ) : (
        <Image {src} {alt} {title} layout="constrained" class="rounded-lg" />
      )
    }
    <figcaption>
      {title}
    </figcaption>
  </figure>
</div>
